{
  "pluginAlias": "SalenteAC",
  "pluginType": "accessory",
  "singular": false,
  "headerDisplay": "Local LAN control for the Salente SummerICE9 portable air conditioner (Tuya protocol 3.5). Get `id` and `key` with `npx @tuyapi/cli wizard`.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Air Conditioner",
        "required": true
      },
      "id": {
        "title": "Tuya device ID",
        "type": "string",
        "required": true,
        "description": "The 'Virtual ID' shown in Smart Life under Device Information."
      },
      "key": {
        "title": "Tuya local key",
        "type": "string",
        "required": true,
        "description": "Changes whenever the device is unpaired and paired again."
      },
      "ip": {
        "title": "IP address",
        "type": "string",
        "required": true,
        "format": "ipv4",
        "description": "Reserve it in your router's DHCP so it does not change."
      },
      "version": {
        "title": "Protocol version",
        "type": "string",
        "default": "3.5",
        "oneOf": [
          { "title": "3.5", "enum": ["3.5"] },
          { "title": "3.4", "enum": ["3.4"] },
          { "title": "3.3", "enum": ["3.3"] }
        ]
      },
      "minTemperature": { "title": "Minimum temperature (°C)", "type": "integer", "default": 16 },
      "maxTemperature": { "title": "Maximum temperature (°C)", "type": "integer", "default": 32 },
      "pollInterval": { "title": "Poll interval (s)", "type": "integer", "default": 15, "minimum": 5 }
    }
  }
}
